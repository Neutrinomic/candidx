+//! Direct typed Motoko heap encoding and the secondary inbound Blob normalizer.
+//! Uses the same no_std CandidX Rust library as the standalone Wasm module.
+
+use crate::allocator::CandidScratchBudget;
+use crate::barriers::allocation_barrier;
+use crate::memory::{Memory, alloc_blob};
+use crate::types::{Bytes, TAG_BLOB_B, Value};
+use motoko_rts_macros::ic_mem_fn;
+
+const MAX_SCRATCH_BYTES: usize = 256 * 1024 * 1024;
+
+use ::candidx::DirectValue;
+use alloc::borrow::Cow;
+use alloc::boxed::Box;
+use alloc::vec;
+use alloc::vec::Vec;
+
+type EncodeResult<T> = core::result::Result<T, ::candidx::Error>;
+
+const MAX_ITEMS: usize = 2_000_000;
+const MAX_BYTES: usize = 32 * 1024 * 1024;
+
+fn invalid(message: &str) -> ! {
+    crate::trap_with_prefix("CandidX error: ", message)
+}
+
+struct Field {
+    id: u32,
+    heap_hash: usize,
+    typ: i32,
+}
+struct Node {
+    op: i32,
+    representation: u32,
+    fields: Vec<Field>,
+}
+struct Metadata {
+    nodes: Vec<Node>,
+    roots: Vec<i32>,
+}
+
+// This is compiler-generated type/layout metadata, never serialized values.
+fn metadata(bytes: &[u8]) -> Metadata {
+    struct Reader<'a> {
+        bytes: &'a [u8],
+        position: usize,
+    }
+    impl Reader<'_> {
+        fn word(&mut self) -> u32 {
+            let end = self
+                .position
+                .checked_add(4)
+                .unwrap_or_else(|| invalid("metadata range"));
+            let span = self
+                .bytes
+                .get(self.position..end)
+                .unwrap_or_else(|| invalid("truncated metadata"));
+            self.position = end;
+            u32::from_le_bytes(span.try_into().unwrap())
+        }
+        fn count(&mut self) -> usize {
+            let n = self.word() as usize;
+            if n > MAX_ITEMS {
+                invalid("metadata collection limit");
+            }
+            n
+        }
+    }
+    if bytes.len() > MAX_BYTES || bytes.get(..4) != Some(b"CXTY") {
+        invalid("invalid heap metadata");
+    }
+    let mut r = Reader { bytes, position: 4 };
+    let count = r.count();
+    let arity = r.count();
+    let roots = (0..arity).map(|_| r.word() as i32).collect::<Vec<_>>();
+    let mut nodes = Vec::with_capacity(count);
+    for _ in 0..count {
+        let op = r.word() as i32;
+        let representation = r.word();
+        let fields = (0..r.count())
+            .map(|_| Field {
+                id: r.word(),
+                heap_hash: r.word() as usize,
+                typ: r.word() as i32,
+            })
+            .collect();
+        nodes.push(Node {
+            op,
+            representation,
+            fields,
+        });
+    }
+    if r.position != bytes.len() {
+        invalid("trailing heap metadata");
+    }
+    let check = |t: i32| {
+        if (t >= 0 && t as usize >= nodes.len())
+            || (t < 0 && !(-17..=-1).contains(&t) && t != -24 && t != -25)
+        {
+            invalid("invalid heap type reference");
+        }
+    };
+    roots.iter().copied().for_each(check);
+    for node in &nodes {
+        node.fields.iter().map(|f| f.typ).for_each(check);
+        match node.op {
+            -18 | -19 if node.fields.len() == 1 => (),
+            -20 | -21 if node.fields.windows(2).all(|f| f[0].id < f[1].id) => (),
+            -22 | -23 | -17 if node.fields.is_empty() => (),
+            _ => invalid("invalid heap metadata node"),
+        }
+    }
+    Metadata { nodes, roots }
+}
+
+unsafe fn forward(value: Value) -> Value {
+    // Bool true is the exceptional odd scalar, not an object pointer.
+    if value.get_raw() == crate::types::TRUE_VALUE {
+        value
+    } else {
+        value.forward_if_possible()
+    }
+}
+
+unsafe fn blob_bytes<'a>(value: Value) -> &'a [u8] {
+    let blob = value.as_blob();
+    core::slice::from_raw_parts(blob.payload_const(), blob.len().as_usize())
+}
+
+// libtommath's MP_64BIT representation uses 60-bit little-endian limbs.
+// Convert magnitude directly to the typed numeric representation, not to LEB.
+unsafe fn magnitude(value: Value) -> (bool, Vec<u8>) {
+    if value.is_scalar() {
+        let number = (value.get_raw() as i64) >> 2;
+        return (number < 0, number.unsigned_abs().to_le_bytes().to_vec());
+    }
+    // Literal big integers and objects moved by GC have a lazily fixed digit
+    // pointer. Use the RTS accessor, as ordinary arithmetic does.
+    let integer = &*value.as_bigint().mp_int_ptr();
+    if integer.used < 0 || integer.used as usize > (4096usize * 7 + 1).div_ceil(60) {
+        invalid("integer length limit");
+    }
+    let bits = crate::tommath_bindings::mp_count_bits(integer) as usize;
+    if bits > 4096 * 7 + 1 {
+        invalid("integer length limit");
+    }
+    let mut bytes = vec![0; bits.div_ceil(8)];
+    for (i, byte) in bytes.iter_mut().enumerate() {
+        let bit = i * 8;
+        let limb = bit / 60;
+        let shift = bit % 60;
+        let low = *integer.dp.add(limb) >> shift;
+        let high = if shift > 52 && limb + 1 < integer.used as usize {
+            *integer.dp.add(limb + 1) << (60 - shift)
+        } else {
+            0
+        };
+        *byte = (low | high) as u8;
+    }
+    (integer.sign != 0, bytes)
+}
+
+#[derive(Clone, Copy)]
+struct SourceValue {
+    typ: i32,
+    raw: Value,
+}
+struct HeapSource<'a> {
+    metadata: &'a Metadata,
+}
+
+impl HeapSource<'_> {
+    fn node(&self, value: SourceValue) -> &Node {
+        if value.typ < 0 {
+            invalid("expected compound heap value");
+        }
+        &self.metadata.nodes[value.typ as usize]
+    }
+    unsafe fn field_value(&self, value: SourceValue, index: usize) -> SourceValue {
+        let node = self.node(value);
+        let field = &node.fields[index];
+        let raw = forward(value.raw);
+        let payload = if node.representation == 1 {
+            raw.as_array().get(index)
+        } else {
+            let object = raw.as_object();
+            let hashes = blob_bytes((*object).hash_blob);
+            let n = hashes.len() / 8;
+            let mut low = 0;
+            let mut high = n;
+            while low < high {
+                let mid = low + (high - low) / 2;
+                let hash =
+                    u64::from_le_bytes(hashes[mid * 8..mid * 8 + 8].try_into().unwrap()) as usize;
+                if hash < field.heap_hash {
+                    low = mid + 1;
+                } else {
+                    high = mid;
+                }
+            }
+            if low == n
+                || u64::from_le_bytes(hashes[low * 8..low * 8 + 8].try_into().unwrap()) as usize
+                    != field.heap_hash
+            {
+                invalid("missing heap record field");
+            }
+            object.get(low)
+        };
+        SourceValue {
+            typ: field.typ,
+            raw: payload,
+        }
+    }
+}
+
+impl ::candidx::DirectSource for HeapSource<'_> {
+    type Value = SourceValue;
+    fn kind(&self, value: SourceValue) -> EncodeResult<i32> {
+        let op = if value.typ >= 0 {
+            self.node(value).op
+        } else {
+            value.typ
+        };
+        match op {
+            -22 | -23 => Err(::candidx::Error(
+                "function and service values are excluded".into(),
+            )),
+            -17 => Err(::candidx::Error("empty or unsupported value".into())),
+            -25 => Ok(-7),
+            _ => Ok(op),
+        }
+    }
+    fn option(&self, value: SourceValue) -> EncodeResult<Option<SourceValue>> {
+        unsafe {
+            let raw = forward(value.raw);
+            if raw == crate::types::NULL_POINTER {
+                return Ok(None);
+            }
+            let payload = if raw.is_non_null_ptr()
+                && raw.get_raw() != crate::types::TRUE_VALUE
+                && raw.tag() == crate::types::TAG_SOME
+            {
+                (*(raw.get_ptr() as *const crate::types::Some)).field
+            } else {
+                raw
+            };
+            Ok(Some(SourceValue {
+                typ: self.node(value).fields[0].typ,
+                raw: payload,
+            }))
+        }
+    }
+    fn vector_len(&self, value: SourceValue) -> EncodeResult<usize> {
+        unsafe {
+            let raw = forward(value.raw);
+            Ok(if self.node(value).representation == 1 {
+                blob_bytes(raw).len()
+            } else {
+                raw.as_array().len()
+            })
+        }
+    }
+    fn vector_element(&self, value: SourceValue, index: usize) -> EncodeResult<SourceValue> {
+        unsafe {
+            let raw = forward(value.raw);
+            let node = self.node(value);
+            Ok(SourceValue {
+                typ: node.fields[0].typ,
+                raw: if node.representation == 1 {
+                    Value::from_raw(((blob_bytes(raw)[index] as usize) << 56) | (1usize << 54))
+                } else {
+                    raw.as_array().get(index)
+                },
+            })
+        }
+    }
+    fn is_binary(&self, value: SourceValue) -> EncodeResult<bool> {
+        Ok(self.node(value).fields[0].typ == -5)
+    }
+    fn binary_slice(&self, value: SourceValue) -> EncodeResult<Option<&[u8]>> {
+        unsafe {
+            Ok(if self.node(value).representation == 1 {
+                Some(blob_bytes(forward(value.raw)))
+            } else {
+                None
+            })
+        }
+    }
+    fn record_len(&self, value: SourceValue) -> EncodeResult<usize> {
+        Ok(self.node(value).fields.len())
+    }
+    fn record_field(
+        &self,
+        value: SourceValue,
+        index: usize,
+    ) -> EncodeResult<::candidx::SourceField<SourceValue>> {
+        let field = &self.node(value).fields[index];
+        let optional = field.typ >= 0 && self.metadata.nodes[field.typ as usize].op == -18;
+        Ok(::candidx::SourceField {
+            id: field.id,
+            optional,
+            value: unsafe { self.field_value(value, index) },
+        })
+    }
+    fn variant(&self, value: SourceValue) -> EncodeResult<(u32, SourceValue)> {
+        unsafe {
+            let raw = forward(value.raw);
+            let variant = &*(raw.get_ptr() as *const crate::types::Variant);
+            let field = self
+                .node(value)
+                .fields
+                .iter()
+                .find(|f| f.heap_hash == variant.tag)
+                .unwrap_or_else(|| invalid("unknown heap variant"));
+            Ok((
+                field.id,
+                SourceValue {
+                    typ: field.typ,
+                    raw: variant.field,
+                },
+            ))
+        }
+    }
+    fn scalar_size_hint(&self, value: SourceValue) -> EncodeResult<usize> {
+        unsafe {
+            let raw = forward(value.raw);
+            Ok(match value.typ {
+                -3 | -4 => {
+                    let bits = if raw.is_scalar() {
+                        let n = ((raw.get_raw() as i64) >> 2).unsigned_abs();
+                        (64 - n.leading_zeros()) as usize
+                    } else {
+                        let integer = raw.as_bigint().mp_int_ptr();
+                        if (*integer).used < 0
+                            || (*integer).used as usize > (4096usize * 7 + 1).div_ceil(60)
+                        {
+                            invalid("integer length limit");
+                        }
+                        crate::tommath_bindings::mp_count_bits(integer) as usize
+                    };
+                    if bits > 4096 * 7 + 1 {
+                        invalid("integer length limit");
+                    }
+                    (bits + usize::from(value.typ == -4)).div_ceil(7).max(1)
+                }
+                -15 => {
+                    let n = crate::text::text_size(raw).as_usize();
+                    if n > MAX_ITEMS {
+                        invalid("collection length limit");
+                    }
+                    n + 10
+                }
+                -24 => blob_bytes(raw).len() + 2,
+                _ => 0,
+            })
+        }
+    }
+    fn scalar(&self, value: SourceValue) -> EncodeResult<DirectValue<'_>> {
+        unsafe {
+            let raw_value = forward(value.raw);
+            let raw = raw_value.get_raw() as u64;
+            Ok(match value.typ {
+                -1 => DirectValue::Null,
+                -16 => DirectValue::Reserved,
+                -2 => DirectValue::Bool(raw != 0),
+                -3 | -4 => {
+                    let (negative, bytes) = magnitude(raw_value);
+                    if value.typ == -3 {
+                        if negative {
+                            invalid("negative Nat");
+                        }
+                        DirectValue::Nat(Cow::Owned(bytes))
+                    } else {
+                        DirectValue::Int {
+                            negative,
+                            magnitude: Cow::Owned(bytes),
+                        }
+                    }
+                }
+                -5 => DirectValue::Nat8((raw >> 56) as u8),
+                -6 => DirectValue::Nat16((raw >> 48) as u16),
+                -7 => DirectValue::Nat32((raw >> 32) as u32),
+                -25 => DirectValue::Nat32((raw >> 43) as u32),
+                -9 => DirectValue::Int8((raw as i64 >> 56) as i8),
+                -10 => DirectValue::Int16((raw as i64 >> 48) as i16),
+                -11 => DirectValue::Int32((raw as i64 >> 32) as i32),
+                -8 | -12 => {
+                    let bits = if raw_value.is_scalar() {
+                        if value.typ == -12 {
+                            (raw as i64 >> 4) as u64
+                        } else {
+                            raw >> 4
+                        }
+                    } else {
+                        (*(raw_value.get_ptr() as *const crate::types::Bits64)).bits
+                    };
+                    if value.typ == -8 {
+                        DirectValue::Nat64(bits)
+                    } else {
+                        DirectValue::Int64(bits as i64)
+                    }
+                }
+                -13 => DirectValue::Float32(f32::from_bits((raw >> 32) as u32)),
+                -14 => DirectValue::Float64(f64::from_bits(
+                    (*(raw_value.get_ptr() as *const crate::types::Bits64)).bits,
+                )),
+                -15 => {
+                    let n = crate::text::text_size(raw_value).as_usize();
+                    if n > MAX_ITEMS {
+                        invalid("collection length limit");
+                    }
+                    let bytes = if raw_value.tag() == crate::types::TAG_BLOB_T {
+                        blob_bytes(raw_value)
+                    } else {
+                        let mut bytes = vec![0; n];
+                        crate::text::text_to_buf(raw_value, bytes.as_mut_ptr());
+                        Box::leak(bytes.into_boxed_slice())
+                    };
+                    DirectValue::Text(
+                        core::str::from_utf8(bytes).unwrap_or_else(|_| invalid("invalid UTF-8")),
+                    )
+                }
+                -24 => DirectValue::Principal(blob_bytes(raw_value)),
+                _ => invalid("unsupported scalar heap value"),
+            })
+        }
+    }
+}
+
+#[ic_mem_fn(ic_only)]
+unsafe fn cx_encode_typed_heap<M: Memory>(mem: &mut M, input: Value, schema: Value) -> Value {
+    // No callback or GC increment occurs until the returned Motoko Blob is
+    // published; original heap spans and transient Rust pointers remain valid.
+    let scratch = CandidScratchBudget::begin(MAX_SCRATCH_BYTES);
+    let schema = metadata(blob_bytes(schema));
+    let source = HeapSource { metadata: &schema };
+    let values = schema
+        .roots
+        .iter()
+        .enumerate()
+        .map(|(i, typ)| {
+            let value = if schema.roots.len() == 1 {
+                input
+            } else {
+                forward(input).as_array().get(i)
+            };
+            SourceValue {
+                typ: *typ,
+                raw: value,
+            }
+        })
+        .collect::<Vec<_>>();
+    let encoded = match ::candidx::encode_source_args(&source, &values) {
+        Ok(bytes) => bytes,
+        Err(error) => invalid(&error.0),
+    };
+    let result = alloc_blob(mem, TAG_BLOB_B, Bytes(encoded.len()));
+    core::ptr::copy_nonoverlapping(
+        encoded.as_ptr(),
+        result.as_blob_mut().payload_addr(),
+        encoded.len(),
+    );
+    drop(encoded);
+    drop(values);
+    drop(schema);
+    drop(scratch);
+    allocation_barrier(result)
+}
+
+#[ic_mem_fn(ic_only)]
+unsafe fn cx_canonicalize_blob<M: Memory>(mem: &mut M, input: Value) -> Value {
+    // Raw Rust pointers remain valid: neither the normalizer nor allocation
+    // performs a GC increment. All scratch is discarded before returning to
+    // generated Motoko code, which may schedule GC at its next safe point.
+    let scratch = CandidScratchBudget::begin(MAX_SCRATCH_BYTES);
+    let blob = input.as_blob();
+    let bytes = core::slice::from_raw_parts(blob.payload_const(), blob.len().as_usize());
+    let canonical = match ::candidx::canonicalize(bytes) {
+        Ok(bytes) => bytes,
+        Err(error) => crate::trap_with_prefix("CandidX error: ", &error.0),
+    };
+    let result = alloc_blob(mem, TAG_BLOB_B, Bytes(canonical.len()));
+    core::ptr::copy_nonoverlapping(
+        canonical.as_ptr(),
+        result.as_blob_mut().payload_addr(),
+        canonical.len(),
+    );
+    drop(canonical);
+    drop(scratch);
+    // Publish the returned Motoko object with the incremental GC allocation
+    // barrier. Scratch blobs use the RTS allocator's normal transient policy.
+    allocation_barrier(result)
+}
