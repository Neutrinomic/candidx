+            (Strm.write_blob env get_position get_x)
+        | Prim Text ->
+          raw_bytes (get_x ^^ Text.size env)
+            (Strm.write_text env get_position get_x)
+        | Prim Principal ->
+          marker 1L ^^ raw_bytes (get_x ^^ Blob.len env)
+            (Strm.write_blob env get_position get_x)
+        | Opt typ ->
