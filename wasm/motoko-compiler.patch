+import Prim "mo:⛔";
+// Literal messages exercise the primitive in both interpreters and Wasm.
+let ordinary : Blob = "\44\49\44\4c\02\6c\02\61\7d\62\01\6e\71\01\00\ff\01\00";
+let canonical : Blob = "\44\49\44\4c\01\6c\01\61\7d\01\00\ff\01";
+assert Prim.canonicalizeCandid(ordinary) == canonical;
+assert Prim.canonicalizeCandid(canonical) == canonical;
+let emptyBinary : Blob = "\44\49\44\4c\01\6d\7b\01\00\00";
+assert Prim.canonicalizeCandid(emptyBinary) == emptyBinary;
--- /dev/null
+++ b/test/run/cx-direct-candid.mo
@@ -0,0 +1,120 @@
+import Prim "mo:⛔";
+
+// Literal expectations exercise the direct operator in source, IR, and Wasm.
+assert to_candid_canonical() == "\44\49\44\4c\00\00";
+assert to_candid_canonical(()) == "\44\49\44\4c\00\01\7f";
+assert to_candid_canonical(true) == "\44\49\44\4c\00\01\7e\01";
+assert to_candid_canonical(1 : Nat) == "\44\49\44\4c\00\01\7d\01";
+assert to_candid_canonical(-1 : Int) == "\44\49\44\4c\00\01\7c\7f";
+assert to_candid_canonical(18446744073709551616 : Nat) ==
+  "\44\49\44\4c\00\01\7d\80\80\80\80\80\80\80\80\80\02";
+assert to_candid_canonical(-18446744073709551616 : Int) ==
+  "\44\49\44\4c\00\01\7c\80\80\80\80\80\80\80\80\80\7e";
+assert to_candid_canonical(255 : Nat8) == "\44\49\44\4c\00\01\7b\ff";
+assert to_candid_canonical(65535 : Nat16) ==
+  "\44\49\44\4c\00\01\7a\ff\ff";
+assert to_candid_canonical(4294967295 : Nat32) ==
+  "\44\49\44\4c\00\01\79\ff\ff\ff\ff";
+assert to_candid_canonical(18446744073709551615 : Nat64) ==
+  "\44\49\44\4c\00\01\78\ff\ff\ff\ff\ff\ff\ff\ff";
+assert to_candid_canonical(-128 : Int8) == "\44\49\44\4c\00\01\77\80";
+assert to_candid_canonical(-32768 : Int16) ==
+  "\44\49\44\4c\00\01\76\00\80";
+assert to_candid_canonical(-2147483648 : Int32) ==
+  "\44\49\44\4c\00\01\75\00\00\00\80";
+assert to_candid_canonical(-9223372036854775808 : Int64) ==
+  "\44\49\44\4c\00\01\74\00\00\00\00\00\00\00\80";
+assert to_candid_canonical('💖') ==
+  "\44\49\44\4c\00\01\79\96\f4\01\00";
+assert to_candid_canonical("abc") == "\44\49\44\4c\00\01\71\03abc";
+assert to_candid_canonical("é") == "\44\49\44\4c\00\01\71\02\c3\a9";
+assert to_candid_canonical("é") != to_candid_canonical("e\u{301}");
+assert to_candid_canonical("ignored" : Any) == "\44\49\44\4c\00\01\70";
+assert to_candid_canonical(Prim.principalOfBlob "\01\02") ==
+  "\44\49\44\4c\00\01\68\01\02\01\02";
+
+assert to_candid_canonical(-0.0 : Float32) ==
+  "\44\49\44\4c\00\01\73\00\00\00\80";
+assert to_candid_canonical(-0.0 : Float) ==
+  "\44\49\44\4c\00\01\72\00\00\00\00\00\00\00\80";
+assert to_candid_canonical((0.0 : Float32) / 0.0) ==
+  "\44\49\44\4c\00\01\73\00\00\c0\7f";
+assert to_candid_canonical(-((0.0 : Float) / 0.0)) ==
+  "\44\49\44\4c\00\01\72\00\00\00\00\00\00\f8\7f";
+
+assert to_candid_canonical(null : ?Text) == "\44\49\44\4c\00\01\7f";
+assert to_candid_canonical(?null : ??Text) ==
+  "\44\49\44\4c\01\6e\7f\01\00\01";
+assert to_candid_canonical(??null : ???Text) ==
+  "\44\49\44\4c\02\6e\01\6e\7f\01\00\01\01";
+
+let record = { a = "abc" };
+let extended : { a : Text; b : ?Text } = { a = "abc"; b = null };
+assert to_candid_canonical(record) ==
+  "\44\49\44\4c\01\6c\01\61\71\01\00\03abc";
+assert to_candid_canonical(record) == to_candid_canonical(extended);
+assert to_candid_canonical((1, null) : (Nat, ?Text)) ==
+  to_candid_canonical({ _0_ = 1 });
+assert to_candid_canonical({ a = ?null : ??Text }) !=
+  to_candid_canonical({ a = null : ??Text });
+assert to_candid_canonical({ a = null }) != to_candid_canonical({});
+
+let narrow : { #b } = #b;
+let wide : { #a; #b; #z } = #b;
+assert to_candid_canonical(narrow) == to_candid_canonical(wide);
+assert to_candid_canonical(wide) ==
+  "\44\49\44\4c\01\6b\01\62\7f\01\00\00";
+let cases : [{ #a; #b; #z }] = [#b, #a];
+assert to_candid_canonical(cases) ==
+  "\44\49\44\4c\02\6d\01\6b\02\61\7f\62\7f\01\00\02\01\00";
+
+let rows : [{ a : Text; b : ?Text; c : ?Nat }] = [
+  { a = "x"; b = null; c = null },
+  { a = "y"; b = ?"z"; c = null }
+];
+assert to_candid_canonical(rows) ==
+  "\44\49\44\4c\03\6d\01\6c\02\61\71\62\02\6e\71\01\00\02\01x\00\01y\01\01z";
+let optionRows : [{ _0_ : ??Text }] = [
+  { _0_ = null }, { _0_ = ?null }, { _0_ = ??"s" }
+];
+assert to_candid_canonical(optionRows) ==
+  "\44\49\44\4c\04\6d\01\6c\01\00\02\6e\03\6e\71\01\00\03\00\01\00\01\01\01s";
+
+assert to_candid_canonical("" : Blob) == to_candid_canonical([] : [Nat8]);
+type Byte = Nat8;
+assert to_candid_canonical("" : Blob) == to_candid_canonical([] : [Byte]);
+assert to_candid_canonical("" : Blob) ==
+  "\44\49\44\4c\01\6d\7b\01\00\00";
+assert to_candid_canonical("\00\ff" : Blob) ==
+  to_candid_canonical([0, 255] : [Nat8]);
+assert to_candid_canonical([] : [Nat64]) ==
+  "\44\49\44\4c\01\6d\6f\01\00\00";
+assert to_candid_canonical([] : [shared () -> async ()]) ==
+  to_candid_canonical([] : [Nat64]);
+assert to_candid_canonical([] : [actor {}]) ==
+  to_candid_canonical([] : [Nat64]);
+
+// The full unsigned Candid ID range is meaningful, including in JavaScript.
+assert to_candid_canonical({ _4294967295_ = true }) ==
+  "\44\49\44\4c\01\6c\01\ff\ff\ff\ff\0f\7e\01\00\01";
+assert Prim.canonicalizeCandid(
+  "\44\49\44\4c\01\6c\01\ff\ff\ff\ff\0f\7e\01\00\01"
+) == to_candid_canonical({ _4294967295_ = true });
+
+type List = ?{ head : Nat; tail : List };
+type ExtendedList = ?{ head : Nat; tail : ExtendedList; meta : ?Text };
+let list : List = ?{ head = 1; tail = ?{ head = 2; tail = null } };
+let extendedList : ExtendedList = ?{
+  head = 1;
+  tail = ?{ head = 2; tail = null; meta = null };
+  meta = null
+};
+assert to_candid_canonical(list) == to_candid_canonical(extendedList);
+assert Prim.canonicalizeCandid(to_candid_canonical(extendedList)) ==
+  to_candid_canonical(extendedList);
+assert to_candid_canonical([null, list] : [List]) ==
+  to_candid_canonical([null, extendedList] : [ExtendedList]);
+assert Prim.canonicalizeCandid(to_candid_canonical([null, list] : [List])) ==
+  to_candid_canonical([null, list] : [List]);
+assert to_candid_canonical(1, true) ==
+  "\44\49\44\4c\00\02\7d\7e\01\01";
