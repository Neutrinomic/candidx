  "baseline_snapshot": "_out/rust-typed-cpu-before",
  "scope": "std CandidType metadata lookup and callback inlining only; no_std DirectSource, typed-tree, core normalizer and canonical wire rules unchanged",
  "implementation": [
    "Keep original typed value visits and actual-shape witness on emission; no ordinary encoder, wire parser or intermediate payload tree.",
    "Cache validated source opcodes, resolved aliases, record numeric labels and selected variant child descriptors using retained Rc identity keys.",
    "Activate caching after 32 actual serializer callbacks; bulk byte/value-step accounting remains separate.",
    "Bound cache at 1024 source nodes and 4096 aggregate record-field/selected-case descriptors; larger valid metadata falls back to original streaming checks.",
    "Validate all variant source labels but register only selected child descriptors; unused variants do not allocate child cache entries.",
    "Preserve sticky callback/compound errors, two-pass shape checks and all output/value/depth limits."
  ],
  "timing_method": "Seven trials per phase, median of per-operation wall time; three warmup calls, adaptive repetitions targeting 25 ms per trial clamped to 2..2000; shared CPU slot isolated during captures. Timings are platform-dependent; min/max are retained.",
