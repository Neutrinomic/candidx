// Regressions for compact vectors, UTF8 span validation, record allocation paths, and limits.
import Prim "mo:⛔";
import CandidX "../src/lib";
func check(id : Text, raw : Blob, expected : Blob) {
  if (CandidX.canonicalize(raw) != #ok(expected)) Prim.trap(id);
};
func reject(id : Text, raw : Blob) {
  switch (CandidX.canonicalize(raw)) { case (#err(_)) {}; case (#ok(_)) Prim.trap(id) }
};
