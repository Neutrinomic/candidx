+/// Typed integration with the existing `candid` crate; decoding remains ordinary Candid.
+#[cfg(feature = "candid")]
+pub fn encode_one<T: candid::CandidType>(value: T) -> Result<Vec<u8>> {
+    let ordinary = candid::encode_one(value).map_err(|e| Error(e.to_string()))?;
+    canonicalize(&ordinary)
+}
+
+#[cfg(feature = "candid")]
+pub fn encode_args<T: candid::utils::ArgumentEncoder>(args: T) -> Result<Vec<u8>> {
+    let ordinary = candid::encode_args(args).map_err(|e| Error(e.to_string()))?;
+    canonicalize(&ordinary)
+}
